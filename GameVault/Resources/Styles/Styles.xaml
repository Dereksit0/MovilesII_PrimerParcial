<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <Thickness x:Key="GvPagePadding">20,16,20,0</Thickness>
    <Thickness x:Key="GvCardPadding">12</Thickness>
    <Thickness x:Key="GvChipPadding">10,4</Thickness>

    <Style TargetType="Page" ApplyToDerivedTypes="True">
        <Setter Property="Padding" Value="0" />
        <Setter Property="BackgroundColor" Value="{StaticResource GvBackground}" />
    </Style>

    <Style TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource GvTextPrimary}" />
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <Style TargetType="Button">
        <Setter Property="TextColor" Value="{StaticResource GvOnPrimary}" />
        <Setter Property="BackgroundColor" Value="{StaticResource GvPrimary}" />
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Padding" Value="18,12" />
        <Setter Property="MinimumHeightRequest" Value="48" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{StaticResource GvSurfaceMuted}" />
                            <Setter Property="TextColor" Value="{StaticResource GvTextMuted}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{StaticResource GvPrimaryDark}" />
                            <Setter Property="Scale" Value="0.98" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style TargetType="ImageButton">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="Padding" Value="8" />
    </Style>

    <Style TargetType="Border">
        <Setter Property="Stroke" Value="{StaticResource GvStroke}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="BackgroundColor" Value="{StaticResource GvSurface}" />
    </Style>

    <Style TargetType="BoxView">
        <Setter Property="Color" Value="{StaticResource GvStroke}" />
    </Style>

    <Style TargetType="Entry">
        <Setter Property="TextColor" Value="{StaticResource GvTextPrimary}" />
        <Setter Property="PlaceholderColor" Value="{StaticResource GvTextMuted}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="MinimumHeightRequest" Value="44" />
    </Style>

    <Style TargetType="Editor">
        <Setter Property="TextColor" Value="{StaticResource GvTextPrimary}" />
        <Setter Property="PlaceholderColor" Value="{StaticResource GvTextMuted}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="FontSize" Value="15" />
    </Style>

    <Style TargetType="Picker">
        <Setter Property="TextColor" Value="{StaticResource GvTextPrimary}" />
        <Setter Property="TitleColor" Value="{StaticResource GvTextMuted}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="MinimumHeightRequest" Value="44" />
    </Style>

    <Style TargetType="DatePicker">
        <Setter Property="TextColor" Value="{StaticResource GvTextPrimary}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="FontFamily" Value="OpenSansRegular" />
    </Style>

    <Style TargetType="TimePicker">
        <Setter Property="TextColor" Value="{StaticResource GvTextPrimary}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="FontFamily" Value="OpenSansRegular" />
    </Style>

    <Style TargetType="SearchBar">
        <Setter Property="TextColor" Value="{StaticResource GvTextPrimary}" />
        <Setter Property="PlaceholderColor" Value="{StaticResource GvTextMuted}" />
        <Setter Property="CancelButtonColor" Value="{StaticResource GvTextSecondary}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="FontFamily" Value="OpenSansRegular" />
    </Style>

    <Style TargetType="Switch">
        <Setter Property="OnColor" Value="{StaticResource GvPrimary}" />
        <Setter Property="ThumbColor" Value="{StaticResource GvTextPrimary}" />
    </Style>

    <Style TargetType="CheckBox">
        <Setter Property="Color" Value="{StaticResource GvPrimary}" />
    </Style>

    <Style TargetType="RadioButton">
        <Setter Property="TextColor" Value="{StaticResource GvTextPrimary}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
    </Style>

    <Style TargetType="ActivityIndicator">
        <Setter Property="Color" Value="{StaticResource GvPrimary}" />
    </Style>

    <Style TargetType="ProgressBar">
        <Setter Property="ProgressColor" Value="{StaticResource GvPrimary}" />
    </Style>

    <Style TargetType="Slider">
        <Setter Property="MinimumTrackColor" Value="{StaticResource GvPrimary}" />
        <Setter Property="MaximumTrackColor" Value="{StaticResource GvStroke}" />
        <Setter Property="ThumbColor" Value="{StaticResource GvPrimary}" />
    </Style>

    <Style TargetType="IndicatorView">
        <Setter Property="IndicatorColor" Value="{StaticResource GvStroke}" />
        <Setter Property="SelectedIndicatorColor" Value="{StaticResource GvPrimary}" />
    </Style>

    <Style TargetType="RefreshView">
        <Setter Property="RefreshColor" Value="{StaticResource GvPrimary}" />
    </Style>

    <Style TargetType="Shell" ApplyToDerivedTypes="True">
        <Setter Property="Shell.BackgroundColor" Value="{StaticResource GvBackground}" />
        <Setter Property="Shell.ForegroundColor" Value="{StaticResource GvTextPrimary}" />
        <Setter Property="Shell.TitleColor" Value="{StaticResource GvTextPrimary}" />
        <Setter Property="Shell.DisabledColor" Value="{StaticResource GvTextMuted}" />
        <Setter Property="Shell.UnselectedColor" Value="{StaticResource GvTextSecondary}" />
        <Setter Property="Shell.NavBarHasShadow" Value="False" />
        <Setter Property="Shell.TabBarBackgroundColor" Value="{StaticResource GvSurface}" />
        <Setter Property="Shell.TabBarForegroundColor" Value="{StaticResource GvPrimary}" />
        <Setter Property="Shell.TabBarTitleColor" Value="{StaticResource GvPrimary}" />
        <Setter Property="Shell.TabBarUnselectedColor" Value="{StaticResource GvTextMuted}" />
    </Style>

    <Style TargetType="NavigationPage">
        <Setter Property="BarBackgroundColor" Value="{StaticResource GvBackground}" />
        <Setter Property="BarTextColor" Value="{StaticResource GvTextPrimary}" />
        <Setter Property="IconColor" Value="{StaticResource GvTextPrimary}" />
    </Style>

    <Style x:Key="PageTitleLabel" TargetType="Label">
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="29" />
        <Setter Property="TextColor" Value="{StaticResource GvTextPrimary}" />
    </Style>

    <Style x:Key="PageSubtitleLabel" TargetType="Label">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextColor" Value="{StaticResource GvTextSecondary}" />
    </Style>

    <Style x:Key="SectionTitleLabel" TargetType="Label">
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="CharacterSpacing" Value="1.6" />
        <Setter Property="TextTransform" Value="Uppercase" />
        <Setter Property="TextColor" Value="{StaticResource GvTextMuted}" />
    </Style>

    <Style x:Key="CardTitleLabel" TargetType="Label">
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="TextColor" Value="{StaticResource GvTextPrimary}" />
    </Style>

    <Style x:Key="MetaLabel" TargetType="Label">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextColor" Value="{StaticResource GvTextSecondary}" />
    </Style>

    <Style x:Key="MutedLabel" TargetType="Label">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextColor" Value="{StaticResource GvTextMuted}" />
    </Style>

    <Style x:Key="PriceLabel" TargetType="Label">
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="TextColor" Value="{StaticResource GvSuccess}" />
    </Style>

    <Style x:Key="StatValueLabel" TargetType="Label">
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="TextColor" Value="{StaticResource GvTextPrimary}" />
    </Style>

    <Style x:Key="StatCaptionLabel" TargetType="Label">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="CharacterSpacing" Value="0.8" />
        <Setter Property="TextTransform" Value="Uppercase" />
        <Setter Property="TextColor" Value="{StaticResource GvTextMuted}" />
    </Style>

    <Style x:Key="CardBorder" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource GvSurface}" />
        <Setter Property="Stroke" Value="{StaticResource GvStroke}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="Padding" Value="{StaticResource GvCardPadding}" />
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="20" />
            </Setter.Value>
        </Setter>
        <Setter Property="Shadow">
            <Setter.Value>
                <Shadow Brush="#000000" Offset="0,10" Radius="20" Opacity="0.5" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PanelBorder" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource GvSurface}" />
        <Setter Property="Stroke" Value="{StaticResource GvStrokeSoft}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="18" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CoverBorder" TargetType="Border">
        <Setter Property="Stroke" Value="{StaticResource GvStrokeSoft}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="BackgroundColor" Value="{StaticResource GvSurfaceMuted}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="14" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ChipBorder" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource GvSurfaceMuted}" />
        <Setter Property="Stroke" Value="{StaticResource GvStroke}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="Padding" Value="{StaticResource GvChipPadding}" />
        <Setter Property="HorizontalOptions" Value="Start" />
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="9" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="AccentChipBorder" TargetType="Border" BasedOn="{StaticResource ChipBorder}">
        <Setter Property="BackgroundColor" Value="{StaticResource GvPrimarySoft}" />
        <Setter Property="Stroke" Value="{StaticResource GvPrimary}" />
    </Style>

    <Style x:Key="SuccessChipBorder" TargetType="Border" BasedOn="{StaticResource ChipBorder}">
        <Setter Property="BackgroundColor" Value="{StaticResource GvSuccessSoft}" />
        <Setter Property="Stroke" Value="{StaticResource GvSuccess}" />
    </Style>

    <Style x:Key="ChipLabel" TargetType="Label">
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="CharacterSpacing" Value="0.4" />
        <Setter Property="TextColor" Value="{StaticResource GvTextSecondary}" />
    </Style>

    <Style x:Key="AccentChipLabel" TargetType="Label" BasedOn="{StaticResource ChipLabel}">
        <Setter Property="TextColor" Value="{StaticResource GvPrimary}" />
    </Style>

    <Style x:Key="SuccessChipLabel" TargetType="Label" BasedOn="{StaticResource ChipLabel}">
        <Setter Property="TextColor" Value="{StaticResource GvSuccess}" />
    </Style>

    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource GvPrimary}" />
        <Setter Property="TextColor" Value="{StaticResource GvOnPrimary}" />
    </Style>

    <Style x:Key="SecondaryButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{StaticResource GvTextSecondary}" />
        <Setter Property="BorderColor" Value="{StaticResource GvStroke}" />
        <Setter Property="BorderWidth" Value="1" />
    </Style>

    <Style x:Key="AccentButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource GvAccentSoft}" />
        <Setter Property="TextColor" Value="{StaticResource GvAccent}" />
        <Setter Property="BorderColor" Value="{StaticResource GvAccent}" />
        <Setter Property="BorderWidth" Value="1" />
    </Style>

    <Style x:Key="FabButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource GvPrimary}" />
        <Setter Property="TextColor" Value="{StaticResource GvOnPrimary}" />
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="26" />
        <Setter Property="CornerRadius" Value="30" />
        <Setter Property="WidthRequest" Value="60" />
        <Setter Property="HeightRequest" Value="60" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <Style x:Key="FormLabel" TargetType="Label">
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="CharacterSpacing" Value="0.6" />
        <Setter Property="TextColor" Value="{StaticResource GvTextSecondary}" />
        <Setter Property="Margin" Value="0,0,0,6" />
    </Style>

    <Style x:Key="FieldBorder" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource GvSurfaceElevated}" />
        <Setter Property="Stroke" Value="{StaticResource GvStroke}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="Padding" Value="12,2" />
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="12" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ErrorLabel" TargetType="Label">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextColor" Value="{StaticResource GvDanger}" />
    </Style>

</ResourceDictionary>
