<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="GameVault.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:GameVault.Views"
    Title="GameVault"
    FlyoutBehavior="Disabled">

    <TabBar>

        <ShellContent
            Title="Colección"
            Icon="icon_coleccion.png"
            Route="lista"
            ContentTemplate="{DataTemplate views:ListaPage}" />

        <ShellContent
            Title="Wishlist"
            Icon="icon_wishlist.png"
            Route="wishlist"
            ContentTemplate="{DataTemplate views:WishlistPage}" />

    </TabBar>

</Shell>
