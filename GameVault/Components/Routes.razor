<Router AppAssembly="@typeof(MauiProgram).Assembly">
    <Found Context="datosDeRuta">
        <RouteView RouteData="@datosDeRuta" DefaultLayout="@typeof(MainLayout)" />
        <FocusOnNavigate RouteData="@datosDeRuta" Selector="h1" />
    </Found>
    <NotFound>
        <LayoutView Layout="@typeof(MainLayout)">
            <MessageStrip Tipo="TipoMensaje.Informacion">No encontramos esa pantalla.</MessageStrip>
        </LayoutView>
    </NotFound>
</Router>
