@inherits LayoutComponentBase

<div class="app">

    @* Shell bar fija, al estilo de la barra superior de las apps Fiori. *@
    <header class="shell-bar">

        <a class="shell-logo" href="" aria-label="GameVault, ir a la colección">
            <Icono Nombre="logo" />
        </a>

        <div class="shell-titulos">
            <span class="shell-titulo">GameVault</span>
            <span class="shell-subtitulo">Mi colección de videojuegos</span>
        </div>

        <div class="shell-acciones">
            <NavLink class="shell-accion" href="nuevo" aria-label="Nuevo juego">
                <Icono Nombre="mas" />
                <span class="shell-accion-texto">Nuevo juego</span>
            </NavLink>
        </div>

    </header>

    <NavMenu />

    <main class="app-main">
        @Body
    </main>

</div>
