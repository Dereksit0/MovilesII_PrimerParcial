@inject IVideojuegoRepository Repositorio
@implements IDisposable

<section class="lista">

    <EncabezadoPagina Titulo="@TituloPantalla" Subtitulo="@SubtituloPantalla">
        <Acciones>
            <button class="btn btn-secundario" @onclick="RecargarAsync" disabled="@cargando">
                <Icono Nombre="refrescar" />
                Actualizar
            </button>
        </Acciones>
    </EncabezadoPagina>

    @if (exitoVisible)
    {
        <MessageStrip Tipo="TipoMensaje.Exito" Cerrable="true" OnCerrar="OcultarExito">@MensajeExito</MessageStrip>
    }

    @if (cargando)
    {
        <div class="cargando" role="status">
            <span class="spinner" aria-hidden="true"></span>
            Consultando GameVault.Api...
        </div>
    }
    else if (error is not null)
    {
        <MessageStrip Tipo="TipoMensaje.Error">
            <span>@error</span>
            <button class="btn btn-secundario" @onclick="RecargarAsync">Intentar de nuevo</button>
        </MessageStrip>
    }
    else
    {
        <div class="resumen">
            <div>
                <strong>@Base.Count</strong>
                <small>Juegos</small>
            </div>
            <div>
                <strong>@ValorTotal</strong>
                <small>Valor total</small>
            </div>
            <div>
                <strong>@Base.Count(juego => juego.Completado)</strong>
                <small>Terminados</small>
            </div>
        </div>

        <div class="buscador">
            <input type="search"
                   placeholder="Buscar juego por título..."
                   value="@textoBusqueda"
                   @oninput="AlEscribir" />

            @if (HayBusqueda)
            {
                <button class="btn btn-ghost" @onclick="LimpiarBusqueda">Limpiar</button>
            }
        </div>

        @if (HayBusqueda)
        {
            <p class="lista-sub">@Visibles.Count de @Base.Count juegos</p>
        }

        <div class="master-detail @(seleccionado is not null ? "con-detalle" : string.Empty) @(ampliado ? "ampliado" : string.Empty)">

            <div class="master">
                @if (Visibles.Count == 0)
                {
                    <MessageStrip Tipo="TipoMensaje.Informacion">@MensajeVacio</MessageStrip>
                }
                else
                {
                    @* Cada juego es un ObjectListItem: titulo, atributos secundarios y estados.
                       Es un <button> de verdad, asi que ya sale con tabindex, role y Enter/Espacio. *@
                    <ul class="lista-objetos" aria-label="Videojuegos">
                        @foreach (var juego in Visibles)
                        {
                            <li>
                                <button type="button"
                                        class="objeto @(EsSeleccionado(juego) ? "activa" : string.Empty)"
                                        aria-pressed="@(EsSeleccionado(juego) ? "true" : "false")"
                                        @onclick="() => SeleccionarAsync(juego)">

                                    <span class="objeto-portada">
                                        @if (juego.TienePortada)
                                        {
                                            <img src="@juego.ImagenUrl" alt="" loading="lazy" />
                                        }
                                        else
                                        {
                                            <span class="objeto-inicial">@Inicial(juego)</span>
                                        }
                                    </span>

                                    <span class="objeto-cuerpo">
                                        <span class="objeto-titulo">@juego.Titulo</span>
                                        <span class="objeto-atributo">@juego.Plataforma · @juego.ValorFormateado</span>
                                        <span class="objeto-atributo">
                                            @if (juego.TieneResenas)
                                            {
                                                @($"{juego.PromedioTexto} · {juego.TotalResenasTexto}")
                                            }
                                            else
                                            {
                                                @juego.TotalResenasTexto
                                            }
                                        </span>
                                    </span>

                                    <span class="objeto-estados">
                                        <span class="@ChipFiori.DeEstado(juego.Estado)">@juego.Estado</span>
                                        @if (juego.Completado)
                                        {
                                            <span class="@ChipFiori.DeProgreso(true)">Completado</span>
                                        }
                                    </span>

                                    <Icono Nombre="siguiente" />

                                </button>
                            </li>
                        }
                    </ul>
                }
            </div>

            @* Aqui esta el punto del master-detail: el seleccionado baja por cascada al panel. *@
            <CascadingValue Value="seleccionado" Name="VideojuegoSeleccionado">
                <PanelDetalle Ampliado="ampliado"
                              OnAlternarAmpliado="AlternarAmpliado"
                              OnCerrar="CerrarDetalle" />
            </CascadingValue>

        </div>
    }

</section>

@code {
    private bool cargando = true;
    private string? error;
    private string textoBusqueda = string.Empty;

    [Parameter]
    public FiltroLista Filtro { get; set; } = FiltroLista.Todos;

    // Mensaje de exito que llega desde otra pantalla (por ejemplo, al guardar un juego nuevo).
    [Parameter]
    public string? MensajeExito { get; set; }

    private string? ultimoMensajeExito;
    private bool exitoVisible;

    private VideojuegoDto? seleccionado;
    private bool ampliado;

    private IReadOnlyList<VideojuegoDto> Base => Filtro switch
    {
        FiltroLista.Wishlist => Repositorio.ObtenerWishlist(),
        FiltroLista.Terminados => Repositorio.ObtenerTerminados(),
        _ => Repositorio.Videojuegos
    };

    private List<VideojuegoDto> Visibles
    {
        get
        {
            var filtro = textoBusqueda.Trim();

            return string.IsNullOrEmpty(filtro)
                ? [.. Base]
                : [.. Base.Where(juego => Coincide(juego.Titulo, filtro))];
        }
    }

    private bool HayBusqueda => !string.IsNullOrWhiteSpace(textoBusqueda);

    private string ValorTotal => FormatoMoneda.Formatear(Base.Sum(juego => juego.ValorEstimado));

    private string TituloPantalla => Filtro switch
    {
        FiltroLista.Wishlist => "Wishlist",
        FiltroLista.Terminados => "Terminados",
        _ => "Mi colección"
    };

    private string SubtituloPantalla => Filtro switch
    {
        FiltroLista.Wishlist => "Lo que quieres conseguir",
        FiltroLista.Terminados => "Los que ya te acabaste",
        _ => "Todo lo que tienes registrado"
    };

    private string MensajeVacio => HayBusqueda
        ? "Ningún juego coincide con esa búsqueda."
        : Filtro switch
        {
            FiltroLista.Wishlist => "Todavía no marcas ningún juego como deseado.",
            FiltroLista.Terminados => "Aún no terminas ningún juego.",
            _ => "La colección está vacía."
        };

    protected override void OnParametersSet()
    {
        if (MensajeExito != ultimoMensajeExito)
        {
            ultimoMensajeExito = MensajeExito;
            exitoVisible = !string.IsNullOrWhiteSpace(MensajeExito);
        }
    }

    protected override async Task OnInitializedAsync()
    {
        Repositorio.CambioLaColeccion += AlCambiarLaColeccion;
        await CargarAsync(forzarRecarga: false);
    }

    private Task RecargarAsync() => CargarAsync(forzarRecarga: true);

    private async Task CargarAsync(bool forzarRecarga)
    {
        cargando = true;
        error = null;

        var resultado = await Repositorio.InicializarAsync(forzarRecarga);

        if (!resultado.Exito)
        {
            error = resultado.MensajeError;
        }

        cargando = false;
    }

    private void AlEscribir(ChangeEventArgs argumentos)
    {
        textoBusqueda = argumentos.Value?.ToString() ?? string.Empty;
        OlvidarSeleccionSiYaNoSeVe();
    }

    private void LimpiarBusqueda() => textoBusqueda = string.Empty;

    // Si el juego seleccionado deja de aparecer en la lista (por la busqueda o porque
    // se borro), el panel se quedaba mostrandolo como si nada.
    private void OlvidarSeleccionSiYaNoSeVe()
    {
        if (seleccionado is not null && Visibles.All(juego => juego.Id != seleccionado.Id))
        {
            seleccionado = null;
        }
    }

    private async Task SeleccionarAsync(VideojuegoDto juego)
    {
        // Pintamos de inmediato lo que ya teniamos y luego pedimos el juego con sus
        // resenas frescas (GET /odata/Videojuegos(id)?$expand=Resenas).
        seleccionado = juego;

        var actualizado = await Repositorio.ObtenerConResenasAsync(juego.Id);

        if (actualizado is not null && seleccionado?.Id == actualizado.Id)
        {
            seleccionado = actualizado;
        }
    }

    private void OcultarExito() => exitoVisible = false;

    private void AlternarAmpliado() => ampliado = !ampliado;

    // Cerrar el panel es soltar la seleccion; en pantallas angostas eso cierra la hoja de detalle.
    private void CerrarDetalle()
    {
        seleccionado = null;
        ampliado = false;
    }

    private bool EsSeleccionado(VideojuegoDto juego) => seleccionado?.Id == juego.Id;

    private static string Inicial(VideojuegoDto juego) =>
        string.IsNullOrWhiteSpace(juego.Titulo) ? "?" : juego.Titulo.Trim()[..1].ToUpperInvariant();

    // La misma comparación que usábamos en el buscador del primer parcial: ignora mayúsculas y acentos.
    private static bool Coincide(string? texto, string filtro) =>
        System.Globalization.CultureInfo.InvariantCulture.CompareInfo.IndexOf(
            texto ?? string.Empty,
            filtro,
            System.Globalization.CompareOptions.IgnoreCase |
            System.Globalization.CompareOptions.IgnoreNonSpace) >= 0;

    private void AlCambiarLaColeccion() => InvokeAsync(() =>
    {
        OlvidarSeleccionSiYaNoSeVe();
        StateHasChanged();
    });

    public void Dispose() => Repositorio.CambioLaColeccion -= AlCambiarLaColeccion;
}
