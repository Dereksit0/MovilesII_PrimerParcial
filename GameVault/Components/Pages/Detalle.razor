@page "/videojuego/{Id:int}"
@inject IVideojuegoRepository Repositorio
@inject NavigationManager Navegacion

@if (cargando)
{
    <div class="cargando" role="status">
        <span class="spinner" aria-hidden="true"></span>
        Cargando el juego...
    </div>
}
else if (juego is null)
{
    <MessageStrip Tipo="TipoMensaje.Error">
        <span>@(error ?? "No encontramos ese juego.")</span>
        <button class="btn btn-secundario" @onclick="Volver">Volver</button>
    </MessageStrip>
}
else
{
    <EncabezadoPagina Titulo="@juego.Titulo" Subtitulo="@juego.Plataforma">
        <Migas>
            <li><a href="@RutaDeRegreso">@NombreMiga</a></li>
            <li aria-current="page">@juego.Titulo</li>
        </Migas>
        <Acciones>
            <button class="btn btn-primario" @onclick="AlternarFavoritoAsync">@TextoFavorito</button>
            <button class="btn btn-secundario" @onclick="AlternarCompletadoAsync">@TextoCompletado</button>
        </Acciones>
    </EncabezadoPagina>

    @if (mensaje is not null)
    {
        <MessageStrip Tipo="tipoMensaje" Cerrable="true" OnCerrar="OcultarMensaje">@mensaje</MessageStrip>
    }

    <button class="btn btn-ghost boton-volver" @onclick="Volver">
        <Icono Nombre="atras" />
        Volver a @NombreDeDonde
    </button>

    @* Estructura de Object Page: cabecera con estados y atributos clave, y luego secciones con titulo. *@
    <article class="object-page">

        <section class="objeto-cabecera" aria-label="Resumen del juego">

            <div class="detalle-portada">
                @if (juego.TienePortada)
                {
                    <img src="@juego.ImagenUrl" alt="Portada de @juego.Titulo" />
                }
            </div>

            <div class="objeto-cabecera-cuerpo">

                <div class="panel-chips">
                    <span class="chip chip-neutral">@juego.Plataforma</span>
                    <span class="@ChipFiori.DeEstado(juego.Estado)">@juego.Estado</span>
                    @if (juego.TieneMetacritic)
                    {
                        <span class="@ChipFiori.DeMetacritic(juego.Metacritic)">@juego.MetacriticTexto</span>
                    }
                    <span class="@ChipFiori.DeProgreso(juego.Completado)">@juego.EtiquetaProgreso</span>
                    @if (juego.EsFavorito)
                    {
                        <span class="chip chip-critico">En wishlist</span>
                    }
                </div>

                <dl class="atributos-clave">
                    <div>
                        <dt>Valor estimado</dt>
                        <dd>@juego.ValorFormateado</dd>
                    </div>
                    <div>
                        <dt>Calificación de la comunidad</dt>
                        <dd>@juego.PromedioTexto</dd>
                    </div>
                    <div>
                        <dt>Reseñas</dt>
                        <dd>@juego.TotalResenasTexto</dd>
                    </div>
                </dl>

            </div>

        </section>

        <section class="seccion" aria-labelledby="seccion-informacion">
            <h2 id="seccion-informacion">Información</h2>

            <dl class="datos-seccion">
                <div>
                    <dt>Plataforma</dt>
                    <dd>@juego.Plataforma</dd>
                </div>
                <div>
                    <dt>Estado en la colección</dt>
                    <dd>@juego.Estado</dd>
                </div>
                <div>
                    <dt>Metacritic</dt>
                    <dd>@(juego.TieneMetacritic ? juego.Metacritic!.Value.ToString() : "Sin dato")</dd>
                </div>
                <div>
                    <dt>Progreso</dt>
                    <dd>@juego.EtiquetaProgreso</dd>
                </div>
                <div>
                    <dt>Wishlist</dt>
                    <dd>@(juego.EsFavorito ? "Sí" : "No")</dd>
                </div>
            </dl>
        </section>

        <section class="seccion" aria-labelledby="seccion-resenas">
            <h2 id="seccion-resenas">Reseñas</h2>

            @if (!juego.TieneResenas)
            {
                <p class="panel-vacio">Este juego todavía no tiene reseñas.</p>
            }
            else
            {
                @foreach (var resena in juego.Resenas.OrderByDescending(r => r.Fecha))
                {
                    <div class="resena">
                        <div class="resena-encabezado">
                            <span class="resena-autor">@resena.Autor</span>
                            <span class="@ChipFiori.DeCalificacion(resena.Calificacion)">@resena.CalificacionTexto</span>
                        </div>
                        <p class="resena-comentario">@resena.Comentario</p>
                        <span class="resena-fecha">@resena.FechaCorta</span>
                    </div>
                }
            }
        </section>

    </article>

    @if (Otros.Count > 0)
    {
        <section class="otros">
            <h2>Otros de tu colección</h2>

            <div class="otros-lista">
                @foreach (var otro in Otros)
                {
                    <a href="@EnlaceA(otro.Id)" class="otro">
                        @if (otro.TienePortada)
                        {
                            <img src="@otro.ImagenUrl" alt="@otro.Titulo" loading="lazy" />
                        }
                        <span>@otro.Titulo</span>
                    </a>
                }
            </div>
        </section>
    }
}

@code {
    private VideojuegoDto? juego;
    private bool cargando = true;
    private string? error;
    private int idCargado;
    private string? mensaje;
    private TipoMensaje tipoMensaje;

    [Parameter]
    public int Id { get; set; }

    // De que pestaña llegamos, para que el boton de volver regrese al mismo lugar.
    [SupplyParameterFromQuery(Name = "desde")]
    public string? Desde { get; set; }

    private string RutaDeRegreso => string.IsNullOrWhiteSpace(Desde) ? "/" : $"/{Desde}";

    private string NombreDeDonde => Desde switch
    {
        "wishlist" => "la wishlist",
        "terminados" => "terminados",
        _ => "la colección"
    };

    private string NombreMiga => Desde switch
    {
        "wishlist" => "Wishlist",
        "terminados" => "Terminados",
        _ => "Colección"
    };

    private string TextoFavorito =>
        juego?.EsFavorito == true ? "Quitar de la wishlist" : "Agregar a la wishlist";

    private string TextoCompletado =>
        juego?.Completado == true ? "Marcar como pendiente" : "Marcar como terminado";

    private List<VideojuegoDto> Otros =>
        [.. Repositorio.Videojuegos.Where(otro => otro.Id != Id).Take(6)];

    private string EnlaceA(int id) =>
        string.IsNullOrWhiteSpace(Desde)
            ? $"videojuego/{id}"
            : $"videojuego/{id}?desde={Uri.EscapeDataString(Desde)}";

    // Va en OnParametersSetAsync y no en OnInitializedAsync: al saltar de un detalle a otro
    // Blazor reutiliza el mismo componente y solo le cambia el Id de la ruta.
    protected override async Task OnParametersSetAsync()
    {
        if (idCargado == Id && juego is not null)
        {
            return;
        }

        idCargado = Id;
        await CargarAsync();
    }

    private async Task CargarAsync()
    {
        cargando = true;
        error = null;
        mensaje = null;

        // La coleccion puede no estar cargada si entramos directo por la ruta.
        var resultado = await Repositorio.InicializarAsync();

        if (!resultado.Exito)
        {
            error = resultado.MensajeError;
            juego = null;
            cargando = false;
            return;
        }

        juego = await Repositorio.ObtenerConResenasAsync(Id);
        cargando = false;
    }

    private async Task AlternarFavoritoAsync()
    {
        var antes = juego?.EsFavorito;
        var resultado = await Repositorio.AlternarFavoritoAsync(Id);

        juego = Repositorio.ObtenerPorId(Id) ?? juego;

        Avisar(resultado, antes != juego?.EsFavorito,
            juego?.EsFavorito == true
                ? $"«{juego.Titulo}» se agregó a tu wishlist."
                : $"«{juego?.Titulo}» salió de tu wishlist.");
    }

    private async Task AlternarCompletadoAsync()
    {
        var antes = juego?.Completado;
        var resultado = await Repositorio.AlternarCompletadoAsync(Id);

        juego = Repositorio.ObtenerPorId(Id) ?? juego;

        Avisar(resultado, antes != juego?.Completado,
            juego?.Completado == true
                ? $"«{juego.Titulo}» quedó como terminado."
                : $"«{juego?.Titulo}» volvió a pendiente.");
    }

    // Si el servicio no guardo el cambio (el repositorio no marca error en ese caso) lo avisamos igual.
    private void Avisar(ResultadoCarga resultado, bool huboCambio, string textoExito)
    {
        if (!resultado.Exito)
        {
            tipoMensaje = TipoMensaje.Error;
            mensaje = resultado.MensajeError;
        }
        else if (!huboCambio)
        {
            tipoMensaje = TipoMensaje.Error;
            mensaje = "No se pudo guardar el cambio en GameVault.Api.";
        }
        else
        {
            tipoMensaje = TipoMensaje.Exito;
            mensaje = textoExito;
        }
    }

    private void OcultarMensaje() => mensaje = null;

    private void Volver() => Navegacion.NavigateTo(RutaDeRegreso);
}
